[Unit]
Description=BPL headend unit table monitor
Wants=network-online.target
After=network-online.target

[Service]
# Password mode requires a native credential store reachable and unlocked
# for this user in the service context (not automatically present on Linux).
# Otherwise use headend_auth=key until a suitable session/store is configured.
Type=simple
User=bplmon
WorkingDirectory=/opt/bpl-monitor
ExecStart=/opt/bpl-monitor/.venv/bin/python /opt/bpl-monitor/monitor.py --config /opt/bpl-monitor/config.json
Restart=on-failure
RestartSec=15
UMask=0077

[Install]
WantedBy=multi-user.target
