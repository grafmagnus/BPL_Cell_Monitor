[Unit]
Description=BPL headend unit table monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=bplmon
WorkingDirectory=/opt/bpl-monitor
ExecStart=/opt/bpl-monitor/.venv/bin/python /opt/bpl-monitor/monitor.py --config /opt/bpl-monitor/config.json
Restart=on-failure
RestartSec=15
UMask=0077

[Install]
WantedBy=multi-user.target
