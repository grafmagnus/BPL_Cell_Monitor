# Merge only required entries into ~/.ssh/config.
# If NMS3_Infra already exists, keep the actual existing jump-host settings.
Host NMS3_Infra
    HostName nms3.example.invalid
    User YOUR_JUMP_USER
    IdentityFile ~/.ssh/id_ed25519
    BatchMode yes
    StrictHostKeyChecking yes

# Targets retain their .eui name for this Host block and known_hosts.
# The collector supplies the freshly resolved DNS IP using -o HostName=IP.
Host *.eui
    User root
    IdentityFile ~/.ssh/id_ed25519
    BatchMode yes
    StrictHostKeyChecking yes

# Collector supplies -J NMS3_Infra, configurable in JSON.
