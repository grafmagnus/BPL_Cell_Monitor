[Unit]
Description=BPL headend unit table monitor
Wants=network-online.target
After=network-online.target

[Service]
# encrypted-file mode works without a desktop keyring. Protect the separate
# key file and grant this service user read access; private POSIX mode 0600.
# native storage additionally needs an unlocked user/session credential store.
Type=simple
User=bplmon
WorkingDirectory=/opt/bpl-monitor
ExecStart=/opt/bpl-monitor/.venv/bin/python /opt/bpl-monitor/monitor.py --config /opt/bpl-monitor/config.json
Restart=on-failure
RestartSec=15
UMask=0077

[Install]
WantedBy=multi-user.target
